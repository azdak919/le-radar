{
  "name": "le-radar",
  "version": "1.0.0",
  "private": true,
  "description": "PWA des médias étudiants du Québec",
  "scripts": {
    "check:syntax": "node tests/check-js-syntax.mjs",
    "test:unit": "node solitaire/scripts/test-solitaire-rules.mjs && node tests/data-integrity.mjs && node tests/radio-nowplaying.mjs && node tests/news-representations.mjs && node tests/author-lib.mjs && node tests/historical-catalog.mjs && node tests/historical-retro-crawl.mjs && node tests/archive-priority.mjs && node tests/maintenance-window.mjs && node tests/static-integrity.mjs && node tests/photo-visual-qc.mjs && node tests/bg-rotation.mjs && node tests/bank-hard-audit.mjs",
    "check": "npm run check:syntax && npm run test:unit",
    "seo": "node scripts/generate-seo.js",
    "seo:update": "node scripts/generate-seo.js --update",
    "audit:banks:hard": "node scripts/audit-banks-hard.js",
    "test:browser": "playwright test",
    "test": "npm run check && npm run test:browser",
    "bank:sync": "node scripts/sync-quebec-backgrounds.js",
    "bank:check": "node scripts/sync-quebec-backgrounds.js --check && node scripts/audit-banks-hard.js",
    "detect:seasons": "node scripts/detect-photo-seasons.js",
    "detect:seasons:update": "node scripts/detect-photo-seasons.js --update --sync",
    "detect:seasons:visual": "node scripts/detect-photo-seasons.js --visual --update --sync",
    "detect:seasons:force": "node scripts/detect-photo-seasons.js --force --update --sync",
    "agents:ledger": "node scripts/agents-ledger.mjs",
    "agents:propose": "node scripts/agents-ledger.mjs --propose",
    "agents:review-session": "node scripts/agents-ledger.mjs --review-session",
    "maintenance:status": "node scripts/maintenance-window.mjs status",
    "maintenance:bots:pause": "node scripts/maintenance-window.mjs bots pause",
    "maintenance:bots:resume": "node scripts/maintenance-window.mjs bots resume",
    "maintenance:release-check": "node scripts/maintenance-window.mjs release-check",
    "agents:record-sold": "node scripts/agents-ledger.mjs --record-sold",
    "agents:reset-session": "node scripts/agents-ledger.mjs --reset-session",
    "agents:harvest": "node scripts/agents-harvest.mjs",
    "agents:harvest:write": "node scripts/agents-harvest.mjs --write",
    "audit:backgrounds": "python3 scripts/audit-quebec-backgrounds.py",
    "maintain:masthead": "node scripts/maintain-quebec-backgrounds.js --update --profile masthead",
    "maintain:masthead:force": "node scripts/maintain-quebec-backgrounds.js --update --force --profile masthead",
    "maintain:pomo": "node scripts/maintain-quebec-backgrounds.js --update --profile pomo",
    "maintain:pomo:force": "node scripts/maintain-quebec-backgrounds.js --update --force --profile pomo",
    "maintain:universities": "node scripts/maintain-quebec-backgrounds.js --update --profile universities",
    "maintain:universities:force": "node scripts/maintain-quebec-backgrounds.js --update --force --profile universities",
    "maintain:nations": "node scripts/maintain-quebec-backgrounds.js --update --profile nations",
    "maintain:nations:force": "node scripts/maintain-quebec-backgrounds.js --update --force --profile nations",
    "maintain:backgrounds": "npm run maintain:masthead",
    "maintain:backgrounds:force": "npm run maintain:masthead:force",
    "maintain:backgrounds:universities": "npm run maintain:universities",
    "maintain:backgrounds:universities:force": "npm run maintain:universities:force",
    "maintain:backgrounds:pomo": "npm run maintain:pomo",
    "maintain:backgrounds:pomo:force": "npm run maintain:pomo:force",
    "maintain:backgrounds:nations": "npm run maintain:nations",
    "maintain:backgrounds:nations:force": "npm run maintain:nations:force",
    "maintain:backgrounds:all": "npm run maintain:masthead && npm run maintain:universities && npm run maintain:pomo && npm run maintain:nations",
    "pin-background": "node scripts/pin-background.js",
    "archive": "node scripts/archive-articles.js",
    "archive:update": "node scripts/archive-articles.js --update",
    "sports:discover": "node scripts/discover-sports.js",
    "sports:discover:update": "node scripts/discover-sports.js --update",
    "sports:update": "node scripts/fetch-sports.js --update",
    "sports:refresh": "node scripts/discover-sports.js --update --fetch",
    "sports:check": "node scripts/fetch-sports.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
