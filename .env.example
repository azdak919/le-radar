# Secrets de publication. Ne pas committer .env.
# Aucune de ces valeurs n’est requise pour npm run dev / npm test.

# Android — clé d’envoi Play (pas la clé de signature Play si Play App Signing est actif)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Empreinte SHA-256 du certificat Play App Signing, pour assetlinks.json
ANDROID_SHA256_CERT=

# Apple — App Store Connect API (clé .p8), pas de mot de passe Apple ID
APPLE_TEAM_ID=
APPLE_APP_STORE_CONNECT_KEY_ID=
APPLE_APP_STORE_CONNECT_ISSUER_ID=
APPLE_APP_STORE_CONNECT_API_KEY_BASE64=
